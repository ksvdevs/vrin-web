{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist/vrin-web/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fragrance-whenever-findings-compare.trycloudflare.com/api/:path*"
    },
    {
      "source": "/sanctum/:path*",
      "destination": "https://fragrance-whenever-findings-compare.trycloudflare.com/sanctum/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}